## ingame-player.yaml
supportpowers-support-powers-palette =
    .ready = 準備完成
    .hold = 暫停

button-command-bar-attack-move =
    .tooltip = 攻擊移動
    .tooltipdesc =
    選取的單位會移到指定位置，
    並攻擊沿途遇到的任何敵人。

    指定目標時按住 <(Ctrl)>，可下達強襲移動，
    沿途攻擊遇到的任何單位或建築。

    左鍵點選圖示，再對目標位置按右鍵。

button-command-bar-force-move =
    .tooltip = 強制移動
    .tooltipdesc =
    選取的單位會移到指定位置
     - 不執行對目標的預設動作
     - 載具會試圖碾過目標位置的敵人
     - 已部署的擊砂兵會解除部署，並移到目標位置

    左鍵點選圖示，再對目標按右鍵。
    指揮單位時按住 <(Alt)> 可暫時啟用。

button-command-bar-force-attack =
    .tooltip = 強制攻擊
    .tooltipdesc =
    選取的單位會攻擊指定的單位或位置
     - 不執行對目標的預設動作
     - 可將己方或盟友指定為目標

    左鍵點選圖示，再對目標按右鍵。
    指揮單位時按住 <(Ctrl)> 可暫時啟用。

button-command-bar-guard =
    .tooltip = 警戒
    .tooltipdesc =
    選取的單位會跟隨指定的單位。

    左鍵點選圖示，再對目標單位按右鍵。

button-command-bar-deploy =
    .tooltip = 部署
    .tooltipdesc =
    選取的單位會執行預設的部署動作
     - 機動建造車會展開成建造廠
     - 擊砂兵會開始或停止吸引沙蟲
     - 毀滅者會無法移動並爆炸

    立刻對選取的單位生效。

button-command-bar-scatter =
    .tooltip = 散開
    .tooltipdesc =
    選取的單位會停止目前的動作，
    並移到附近的位置。

    立刻對選取的單位生效。

button-command-bar-stop =
    .tooltip = 停止
    .tooltipdesc =
    選取的單位會停止目前的動作。
    選取的建築會重設集結點。

    立刻對選取的目標生效。

button-command-bar-queue-orders =
    .tooltip = 路徑點模式
    .tooltipdesc =
    用路徑點模式，對選取的單位
    下達多個前後相連的指令。單位一收到
    就會立刻執行。

    左鍵點選圖示，再在遊戲世界中下達指令。
    指揮單位時按住 <(Shift)> 可暫時啟用。

button-stance-bar-attackanything =
    .tooltip = 攻擊任何目標姿態
    .tooltipdesc =
    將選取的單位設為攻擊任何目標姿態：
     - 單位一看見敵方單位與建築就會攻擊
     - 單位會穿越戰場追擊攻擊者

button-stance-bar-defend =
    .tooltip = 防禦姿態
    .tooltipdesc =
    將選取的單位設為防禦姿態：
     - 單位一看見敵方單位就會攻擊
     - 單位不會移動，也不會追擊敵人

button-stance-bar-returnfire =
    .tooltip = 還擊姿態
    .tooltipdesc =
    將選取的單位設為還擊姿態：
     - 單位會反擊攻擊自己的敵人
     - 單位不會移動，也不會追擊敵人

button-stance-bar-holdfire =
    .tooltip = 停火姿態
    .tooltipdesc =
    將選取的單位設為停火姿態：
     - 單位不會對敵人開火
     - 單位不會移動，也不會追擊敵人

